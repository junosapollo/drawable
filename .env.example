# Copy to .env (repository root is fine for the web app; services/api reads its own .env or the environment).
# Every value has a working default; nothing here is required.

# --- API (services/api) ---------------------------------------------------
# Path to a validated gallery manifest. Relative paths resolve from the repo root.
# Defaults to ml/fixtures/synthetic/manifest.json in fixture mode. Empty value = no gallery.
# LINESCOUT_GALLERY_MANIFEST=data/gallery/2026.10.01/manifest.json
# auto | cuda | cpu
LINESCOUT_DEVICE=auto
# Serve deterministic fixture rankings until Milestone 4 models exist.
LINESCOUT_FIXTURE_MODE=true
# Expose /api/v1/curation/* (local curation UI only).
LINESCOUT_CURATION_MODE=false
LINESCOUT_PORT=8000
LINESCOUT_DB_PATH=data/linescout.sqlite3

# --- Web (apps/web) -------------------------------------------------------
# Where the Vite dev server proxies /api. The browser never sees this.
LINESCOUT_API_URL=http://127.0.0.1:8000
# Force a service mode instead of probing /api/v1/health: live | fixture
# VITE_LINESCOUT_SERVICES=live
