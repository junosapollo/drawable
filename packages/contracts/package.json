{
  "name": "@drawable/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generated TypeScript API contracts and shared enums for LineScout.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts",
    "./openapi.json": "./openapi.json",
    "./manifest.schema.json": "./manifest.schema.json"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/openapi.ts --alphabetize --enum-values",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.9.2"
  }
}
